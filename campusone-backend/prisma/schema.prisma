// Prisma Schema for CampusOne - PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ USER MODELS ============

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  email                 String    @unique
  name                  String
  password              String
  profilePicture        String?
  role                  String    // "student", "teacher", "admin"
  isActive              Boolean   @default(true)
  isFirstLogin          Boolean   @default(true)
  lastLogin             DateTime?
  passwordChangedAt     DateTime?

  // Security
  accountLocked         Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  accountLockedUntil    DateTime?

  // 2FA
  twoFactorSecret       String?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorMethod       String?   // "authenticator", "email"
  emailOTP              String?
  emailOTPExpiry        DateTime?

  // Relationships
  trustedDevices        TrustedDevice[]
  student               Student?
  teacher               Teacher?
  admin                 Admin?

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([role])
}

model TrustedDevice {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId              String
  deviceName            String?
  userAgent             String?
  ipAddress             String?
  lastUsed              DateTime  @default(now())
  createdAt             DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model Student {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId             String    @unique
  enrollmentYear        Int
  department            String
  batch                 String
  currentSemester       Int

  // Personal Info
  phone                 String?
  address               String?
  emergencyContact      String?
  dateOfBirth           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([studentId])
}

model Teacher {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId            String    @unique
  department            String
  designation           String
  qualification         String?
  specialization        Json      @default("[]")

  // Contact
  officeRoom            String?
  officeHours           String?
  phone                 String?
  extensionNumber       String?

  // Academic
  researchInterests     Json      @default("[]")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([employeeId])
}

model Admin {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId            String    @unique
  department            String?
  designation           String
  phone                 String?
  officeRoom            String?

  isSuperAdmin          Boolean   @default(false)
  permissions           String[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isSuperAdmin])
}




// ============ ANNOUNCEMENTS ============

model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String
  priority        String    @default("medium") // "low", "medium", "high"
  targetAudience  String?   // "all", "teachers", "students"
  createdBy       String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdBy])
  @@index([createdAt])
}

// ============ ADMINISTRATIVE & SYSTEM ============

model AuditLog {
  id                    String    @id @default(cuid())
  action                String
  category              String
  performedBy           String
  performedByRole       String

  targetModel           String
  targetId              String
  relatedEntities       Json      @default("[]")

  previousValue         Json?
  newValue              Json?

  description           String?
  remarks               String?

  createdAt             DateTime  @default(now())

  @@index([performedBy])
  @@index([targetModel])
  @@index([category])
}

// ============ ADMISSION MANAGEMENT ============

model AdmissionSettings {
  id                    String    @id @default(cuid())
  isOpen                Boolean   @default(false)
  startDate             DateTime?
  endDate               DateTime?

  applicationFormFields Json      @default("[]")
  instructions          String?
  maxApplications       Int?

  requiresDocuments     Boolean   @default(false)
  requiredDocuments     Json      @default("[]")
  notificationEmails    Json      @default("[]")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model AdmissionApplication {
  id                    String    @id @default(cuid())
  applicationNumber     String    @unique

  // Personal Info
  fullName              String
  email                 String    @unique
  phone                 String    @unique
  cnic                  String    @unique
  dateOfBirth           DateTime?
  gender                String
  cnicFront             String?
  cnicBack              String?

  // Program Selection
  program               String

  // Nested JSON objects (address, guardian, education)
  address               Json      @default("{}")
  guardian              Json      @default("{}")
  educationRecords      Json      @default("[]")

  // Documents & Status
  documents             Json      @default("[]")
  applicationStatus     String    @default("Pending")
  applicationDate       DateTime  @default(now())
  remarks               String?

  // Linked user (if submitted while logged in)
  userId                String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([applicationStatus])
  @@index([userId])
}
