// Prisma Schema for CampusOne - PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ USER MODELS ============

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  email                 String    @unique
  name                  String
  password              String
  profilePicture        String?
  role                  String    // "student", "teacher", "admin"
  isActive              Boolean   @default(true)
  isFirstLogin          Boolean   @default(true)
  lastLogin             DateTime?
  passwordChangedAt     DateTime?

  // Security
  accountLocked         Boolean   @default(false)
  failedLoginAttempts   Int       @default(0)
  accountLockedUntil    DateTime?

  // 2FA
  twoFactorSecret       String?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorMethod       String?   // "authenticator", "email"
  emailOTP              String?
  emailOTPExpiry        DateTime?

  // Relationships
  trustedDevices        TrustedDevice[]
  student               Student?
  teacher               Teacher?
  admin                 Admin?

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([role])
}

model TrustedDevice {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId              String
  deviceName            String?
  userAgent             String?
  ipAddress             String?
  lastUsed              DateTime  @default(now())
  createdAt             DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model Student {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId             String    @unique
  enrollmentYear        Int
  batch                 String
  currentSemester       Int

  programId             String
  program               Program   @relation(fields: [programId], references: [id])
  curriculumId          String
  curriculum            Curriculum @relation(fields: [curriculumId], references: [id])
  departmentId          String
  department            Department @relation(fields: [departmentId], references: [id])

  enrollments           Enrollment[]
  submissions           Submission[]
  attendances           Attendance[]

  // Personal Info
  phone                 String?
  address               String?
  emergencyContact      String?
  dateOfBirth           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([studentId])
  @@index([programId])
  @@index([curriculumId])
  @@index([departmentId])
}

model Teacher {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId            String    @unique
  designation           String
  qualification         String?
  specialization        Json      @default("[]")

  departmentId          String
  department            Department @relation("DeptMembers", fields: [departmentId], references: [id])
  hodOf                 Department? @relation("DeptHOD")

  offerings             CourseOffering[]
  incharges             SemesterIncharge[]

  // Contact
  officeRoom            String?
  officeHours           String?
  phone                 String?
  extensionNumber       String?

  // Academic
  researchInterests     Json      @default("[]")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([employeeId])
  @@index([departmentId])
}

model Admin {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId            String    @unique
  designation           String
  phone                 String?
  officeRoom            String?

  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id])

  isSuperAdmin          Boolean   @default(false)
  permissions           String[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isSuperAdmin])
  @@index([departmentId])
}




// ============ ANNOUNCEMENTS ============

model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String
  priority        String    @default("medium") // "low", "medium", "high"
  targetAudience  String?   // "all", "teachers", "students"
  createdBy       String

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdBy])
  @@index([createdAt])
}

// ============ ADMINISTRATIVE & SYSTEM ============

model AuditLog {
  id                    String    @id @default(cuid())
  action                String
  category              String
  performedBy           String
  performedByRole       String

  targetModel           String
  targetId              String
  relatedEntities       Json      @default("[]")

  previousValue         Json?
  newValue              Json?

  description           String?
  remarks               String?

  createdAt             DateTime  @default(now())

  @@index([performedBy])
  @@index([targetModel])
  @@index([category])
}

// ============ ADMISSION MANAGEMENT ============

model AdmissionSettings {
  id                    String    @id @default(cuid())
  isOpen                Boolean   @default(false)
  startDate             DateTime?
  endDate               DateTime?

  applicationFormFields Json      @default("[]")
  instructions          String?
  maxApplications       Int?

  requiresDocuments     Boolean   @default(false)
  requiredDocuments     Json      @default("[]")
  notificationEmails    Json      @default("[]")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model AdmissionApplication {
  id                    String    @id @default(cuid())
  applicationNumber     String    @unique

  // Personal Info
  fullName              String
  email                 String    @unique
  phone                 String    @unique
  cnic                  String    @unique
  dateOfBirth           DateTime?
  gender                String
  cnicFront             String?
  cnicBack              String?

  // Program Selection
  program               String

  // Nested JSON objects (address, guardian, education)
  address               Json      @default("{}")
  guardian              Json      @default("{}")
  educationRecords      Json      @default("[]")

  // Documents & Status
  documents             Json      @default("[]")
  applicationStatus     String    @default("Pending")
  applicationDate       DateTime  @default(now())
  remarks               String?

  // Linked user (if submitted while logged in)
  userId                String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([applicationStatus])
  @@index([userId])
}

// ============ ACADEMIC STRUCTURE ============

enum ProgramType {
  BACHELOR
  MASTER
  PHD
  DIPLOMA
}

enum CourseType {
  CORE
  ELECTIVE
  LAB
  GENERAL
}

enum TermSeason {
  FALL
  SPRING
  SUMMER
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
  FAILED
  WITHDRAWN
  INCOMPLETE
}

enum GradeLetter {
  A_PLUS
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D_PLUS
  D
  F
  I
  W
}

model Department {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  description   String?

  hodTeacherId  String?    @unique
  hod           Teacher?   @relation("DeptHOD", fields: [hodTeacherId], references: [id])

  programs      Program[]
  courses       Course[]
  students      Student[]
  teachers      Teacher[]  @relation("DeptMembers")
  admins        Admin[]

  isActive      Boolean    @default(true)
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([code])
  @@index([isActive])
}

model Program {
  id             String      @id @default(cuid())
  programCode    String      @unique
  name           String
  type           ProgramType
  totalSemesters Int
  totalCredits   Int

  departmentId   String
  department     Department  @relation(fields: [departmentId], references: [id])

  curricula      Curriculum[]
  students       Student[]
  incharges      SemesterIncharge[]

  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([departmentId])
  @@index([isActive])
}

model Curriculum {
  id                String   @id @default(cuid())
  programId         String
  program           Program  @relation(fields: [programId], references: [id])

  version           String                  // "2022", "2025"
  effectiveFromYear Int
  effectiveToYear   Int?                    // null = current
  totalCredits      Int

  isActive          Boolean  @default(true)

  courses           CurriculumCourse[]
  students          Student[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([programId, version])
  @@index([programId, isActive])
}

model Course {
  id              String     @id @default(cuid())
  code            String     @unique
  title           String
  description     String?
  creditHours     Int

  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])

  prerequisites    Course[]  @relation("CoursePrereq")
  prerequisiteFor  Course[]  @relation("CoursePrereq")

  curriculumLinks CurriculumCourse[]
  offerings       CourseOffering[]

  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([departmentId])
}

model CurriculumCourse {
  id            String     @id @default(cuid())
  curriculumId  String
  courseId      String

  semesterSlot  Int
  type          CourseType @default(CORE)
  isElective    Boolean    @default(false)

  curriculum    Curriculum @relation(fields: [curriculumId], references: [id])
  course        Course     @relation(fields: [courseId], references: [id])

  @@unique([curriculumId, courseId])
  @@index([curriculumId, semesterSlot])
}

model Term {
  id                   String     @id @default(cuid())
  code                 String     @unique               // "FA26", "SP27"
  season               TermSeason
  academicYear         String                           // "2026-2027"
  startDate            DateTime
  endDate              DateTime
  registrationOpenAt   DateTime?
  registrationCloseAt  DateTime?
  isActive             Boolean    @default(true)

  offerings            CourseOffering[]

  @@index([academicYear, season])
  @@index([isActive])
}

model CourseOffering {
  id           String   @id @default(cuid())
  courseId     String
  termId       String
  teacherId    String
  section      String
  capacity     Int      @default(40)
  schedule     Json     @default("[]")

  course       Course   @relation(fields: [courseId], references: [id])
  term         Term     @relation(fields: [termId], references: [id])
  teacher      Teacher  @relation(fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  assignments  Assignment[]
  attendances  Attendance[]

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([courseId, termId, section])
  @@index([teacherId, termId])
  @@index([termId])
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  offeringId      String
  status          EnrollmentStatus @default(ENROLLED)

  assignmentMarks Float?
  midMarks        Float?
  finalMarks      Float?
  totalMarks      Float?
  gradeLetter     GradeLetter?
  gradePoints     Float?

  student         Student        @relation(fields: [studentId], references: [id])
  offering        CourseOffering @relation(fields: [offeringId], references: [id])

  enrolledAt      DateTime       @default(now())
  droppedAt       DateTime?
  completedAt     DateTime?

  @@unique([studentId, offeringId])
  @@index([studentId])
  @@index([offeringId])
  @@index([status])
}

model SemesterIncharge {
  id              String   @id @default(cuid())
  teacherId       String
  programId       String
  batch           String
  academicYear    String
  semesterNumber  Int
  status          String   @default("active")

  teacher         Teacher  @relation(fields: [teacherId], references: [id])
  program         Program  @relation(fields: [programId], references: [id])

  assignedAt      DateTime @default(now())
  relievedAt      DateTime?

  @@unique([programId, batch, semesterNumber, academicYear])
  @@index([teacherId, status])
}

// ============ ASSIGNMENT MANAGEMENT ============

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

model Assignment {
  id            String           @id @default(cuid())
  offeringId    String
  title         String
  description   String?
  totalMarks    Float            @default(100)
  dueDate       DateTime
  allowLate     Boolean          @default(false)
  attachmentUrl String?
  status        AssignmentStatus @default(PUBLISHED)

  offering      CourseOffering   @relation(fields: [offeringId], references: [id])
  submissions   Submission[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([offeringId])
  @@index([dueDate])
  @@index([status])
}

// ============ ATTENDANCE MANAGEMENT ============

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id         String           @id @default(cuid())
  offeringId String
  studentId  String
  date       String           // YYYY-MM-DD
  status     AttendanceStatus @default(PRESENT)
  markedBy   String           // teacher id

  offering   CourseOffering   @relation(fields: [offeringId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id])

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([offeringId, studentId, date])
  @@index([offeringId, date])
  @@index([studentId])
}

model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String

  submissionText String?
  attachmentUrl  String?
  isLate         Boolean          @default(false)

  obtainedMarks  Float?
  feedback       String?
  gradedAt       DateTime?
  gradedBy       String?

  status         SubmissionStatus @default(SUBMITTED)

  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id])

  submittedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}
