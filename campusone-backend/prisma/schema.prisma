// Prisma Schema for CampusOne - PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ USER MODELS ============

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  name              String
  password          String
  profilePicture    String?
  role              String // "student", "teacher", "admin"
  isActive          Boolean   @default(true)
  isFirstLogin      Boolean   @default(true)
  lastLogin         DateTime?
  passwordChangedAt DateTime?

  // Security
  accountLocked       Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?

  // 2FA
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String? // "authenticator", "email"
  emailOTP         String?
  emailOTPExpiry   DateTime?

  // Relationships
  trustedDevices TrustedDevice[]
  student        Student?
  teacher        Teacher?
  admin          Admin?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  userAgent  String?
  ipAddress  String?
  lastUsed   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId       String @unique
  enrollmentYear  Int
  batch           String
  currentSemester Int

  programId    String
  program      Program    @relation(fields: [programId], references: [id])
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  enrollments       Enrollment[]
  submissions       Submission[]
  attendances       Attendance[]
  quizAttempts      QuizAttempt[]
  quizReopenGrants  QuizReopenGrant[]
  leaveApplications LeaveApplication[]
  fines             Fine[]
  taAssignments     TAAssignment[]
  taPendingGrades   TAPendingGrade[]
  taResources       TAResource[]

  // Personal Info
  phone            String?
  address          String?
  emergencyContact String?
  dateOfBirth      DateTime?

  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([programId])
  @@index([curriculumId])
  @@index([departmentId])
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId     String  @unique
  designation    String
  qualification  String?
  specialization Json    @default("[]")

  departmentId String
  department   Department  @relation("DeptMembers", fields: [departmentId], references: [id])
  hodOf        Department? @relation("DeptHOD")

  offerings CourseOffering[]
  incharges SemesterIncharge[]

  // Contact
  officeRoom      String?
  officeHours     String?
  phone           String?
  extensionNumber String?

  // Academic
  researchInterests Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([departmentId])
}

model Admin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId  String  @unique
  designation String
  phone       String?
  officeRoom  String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  isSuperAdmin Boolean  @default(false)
  permissions  String[]

  // Recovery keys (only used by super admins) — hashed, one-time use
  recoveryKeys String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isSuperAdmin])
  @@index([departmentId])
}

// ============ ANNOUNCEMENTS ============

model Announcement {
  id              String          @id @default(cuid())
  title           String
  content         String
  priority        String          @default("medium") // "low", "medium", "high"
  targetAudience  String? // "all", "teachers", "students", "course", "filtered"
  audienceFilters Json? // { departmentIds, programIds, batches, semesters, role }
  offeringId      String? // set when targetAudience = "course"
  offering        CourseOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdBy       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@index([createdAt])
  @@index([offeringId])
}

// ============ ADMINISTRATIVE & SYSTEM ============

model AuditLog {
  id              String @id @default(cuid())
  action          String
  category        String
  performedBy     String
  performedByRole String

  targetModel     String
  targetId        String
  relatedEntities Json   @default("[]")

  previousValue Json?
  newValue      Json?

  description String?
  remarks     String?

  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([performedBy])
  @@index([targetModel])
  @@index([category])
}

// ============ ADMISSION MANAGEMENT ============

model AdmissionSettings {
  id        String    @id @default(cuid())
  isOpen    Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?

  applicationFormFields Json    @default("[]")
  instructions          String?
  maxApplications       Int?

  requiresDocuments  Boolean @default(false)
  requiredDocuments  Json    @default("[]")
  notificationEmails Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdmissionApplication {
  id                String @id @default(cuid())
  applicationNumber String @unique

  // Personal Info
  fullName    String
  email       String    @unique
  phone       String    @unique
  cnic        String    @unique
  dateOfBirth DateTime?
  gender      String
  cnicFront   String?
  cnicBack    String?

  // Program Selection
  program String

  // Nested JSON objects (address, guardian, education)
  address          Json @default("{}")
  guardian         Json @default("{}")
  educationRecords Json @default("[]")

  // Documents & Status
  documents         Json     @default("[]")
  applicationStatus String   @default("Pending")
  applicationDate   DateTime @default(now())
  remarks           String?

  // Linked user (if submitted while logged in)
  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationStatus])
  @@index([userId])
}

// ============ ACADEMIC STRUCTURE ============

enum ProgramType {
  BACHELOR
  MASTER
  PHD
  DIPLOMA
}

enum CourseType {
  CORE
  ELECTIVE
  LAB
  GENERAL
}

enum TermSeason {
  FALL
  SPRING
  SUMMER
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
  FAILED
  WITHDRAWN
  INCOMPLETE
}

enum GradeLetter {
  A_PLUS
  A
  A_MINUS
  B_PLUS
  B
  B_MINUS
  C_PLUS
  C
  C_MINUS
  D_PLUS
  D
  F
  I
  W
}

model Department {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  hodTeacherId String?  @unique
  hod          Teacher? @relation("DeptHOD", fields: [hodTeacherId], references: [id])

  programs Program[]
  courses  Course[]
  students Student[]
  teachers Teacher[] @relation("DeptMembers")
  admins   Admin[]

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model Program {
  id             String      @id @default(cuid())
  programCode    String      @unique
  name           String
  type           ProgramType
  totalSemesters Int
  totalCredits   Int

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  curricula Curriculum[]
  students  Student[]
  incharges SemesterIncharge[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([isActive])
}

model Curriculum {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id])

  version           String // "2022", "2025"
  effectiveFromYear Int
  effectiveToYear   Int? // null = current
  totalCredits      Int

  isActive Boolean @default(true)

  courses  CurriculumCourse[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, version])
  @@index([programId, isActive])
}

model Course {
  id          String  @id @default(cuid())
  code        String  @unique
  title       String
  description String?
  creditHours Int

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  prerequisites   Course[] @relation("CoursePrereq")
  prerequisiteFor Course[] @relation("CoursePrereq")

  sessionType SessionType @default(LECTURE)

  curriculumLinks CurriculumCourse[]
  offerings       CourseOffering[]
  gradeComponents CourseGradeComponent[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model CurriculumCourse {
  id           String @id @default(cuid())
  curriculumId String
  courseId     String

  semesterSlot Int
  type         CourseType @default(CORE)
  isElective   Boolean    @default(false)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])

  @@unique([curriculumId, courseId])
  @@index([curriculumId, semesterSlot])
}

model Term {
  id                  String     @id @default(cuid())
  code                String     @unique // "FA26", "SP27"
  season              TermSeason
  academicYear        String // "2026-2027"
  startDate           DateTime
  endDate             DateTime
  registrationOpenAt  DateTime?
  registrationCloseAt DateTime?
  isActive            Boolean    @default(true)

  offerings CourseOffering[]

  @@index([academicYear, season])
  @@index([isActive])
}

model CourseOffering {
  id        String @id @default(cuid())
  courseId  String
  termId    String
  teacherId String
  section   String
  capacity  Int    @default(40)

  course            Course             @relation(fields: [courseId], references: [id])
  term              Term               @relation(fields: [termId], references: [id])
  teacher           Teacher            @relation(fields: [teacherId], references: [id])
  enrollments       Enrollment[]
  assignments       Assignment[]
  attendances       Attendance[]
  quizzes           Quiz[]
  qnaThreads        QnaThread[]
  leaveApplications LeaveApplication[]
  fines             Fine[]
  taAssignments     TAAssignment[]
  sessions          ClassSession[]
  lectures          Lecture[]
  announcements     Announcement[]
  taResources       TAResource[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, termId, section])
  @@index([teacherId, termId])
  @@index([termId])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  offeringId String
  status     EnrollmentStatus @default(ENROLLED)

  assignmentMarks Float?
  midMarks        Float?
  finalMarks      Float?
  totalMarks      Float?
  gradeLetter     GradeLetter?
  gradePoints     Float?

  student        Student         @relation(fields: [studentId], references: [id])
  offering       CourseOffering  @relation(fields: [offeringId], references: [id])
  markComponents MarkComponent[]

  enrolledAt  DateTime  @default(now())
  droppedAt   DateTime?
  completedAt DateTime?

  @@unique([studentId, offeringId])
  @@index([studentId])
  @@index([offeringId])
  @@index([status])
}

model SemesterIncharge {
  id             String @id @default(cuid())
  teacherId      String
  programId      String
  batch          String
  academicYear   String
  semesterNumber Int
  status         String @default("active")

  teacher Teacher @relation(fields: [teacherId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  assignedAt DateTime  @default(now())
  relievedAt DateTime?

  @@unique([programId, batch, semesterNumber, academicYear])
  @@index([teacherId, status])
}

// ============ ASSIGNMENT MANAGEMENT ============

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

enum TAPendingGradeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SimilarityReportStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SimilarityMatchType {
  EXACT_FILE
  EXACT_TEXT
  HIGH_LEXICAL
  SEMANTIC
}

enum SimilarityReviewDecision {
  PENDING
  CONFIRMED
  DISMISSED
  NEEDS_DISCUSSION
}

model Assignment {
  id             String           @id @default(cuid())
  offeringId     String
  componentIndex Int?
  title          String
  description    String?
  totalMarks     Float            @default(100)
  dueDate        DateTime
  allowLate      Boolean          @default(false)
  attachmentUrl  String?
  status         AssignmentStatus @default(PUBLISHED)

  offering             CourseOffering        @relation(fields: [offeringId], references: [id])
  submissions          Submission[]
  similarityReports    SimilarityReport[]
  similarityEmbeddings SimilarityEmbedding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, componentIndex])
  @@index([offeringId])
  @@index([dueDate])
  @@index([status])
}

// ============ ATTENDANCE MANAGEMENT ============

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id         String           @id @default(cuid())
  offeringId String
  studentId  String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  markedBy   String // teacher id

  offering CourseOffering @relation(fields: [offeringId], references: [id])
  student  Student        @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, studentId, date])
  @@index([offeringId, date])
  @@index([studentId])
}

model Submission {
  id           String @id @default(cuid())
  assignmentId String
  studentId    String

  submissionText String?
  attachmentUrl  String?
  isLate         Boolean @default(false)

  obtainedMarks Float?
  feedback      String?
  gradedAt      DateTime?
  gradedBy      String?

  status SubmissionStatus @default(SUBMITTED)

  assignment           Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student              Student               @relation(fields: [studentId], references: [id])
  similarityMatchesA   SimilarityMatch[]     @relation("SimilaritySubmissionA")
  similarityMatchesB   SimilarityMatch[]     @relation("SimilaritySubmissionB")
  similarityEmbeddings SimilarityEmbedding[]
  taPendingGrades      TAPendingGrade[]      @relation("PendingSubmissionGrade")

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model TAPendingGrade {
  id          String @id @default(cuid())
  taStudentId String

  submissionId String?
  answerId     String?

  marksAwarded Float
  feedback     String?
  status       TAPendingGradeStatus @default(PENDING)

  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  appliedGrade Float?

  taStudent  Student     @relation(fields: [taStudentId], references: [id])
  submission Submission? @relation("PendingSubmissionGrade", fields: [submissionId], references: [id], onDelete: Cascade)
  answer     QuizAnswer? @relation("PendingQuizAnswerGrade", fields: [answerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, taStudentId])
  @@unique([answerId, taStudentId])
  @@index([status, createdAt])
  @@index([taStudentId])
}

model SimilarityReport {
  id           String                 @id @default(cuid())
  assignmentId String
  createdById  String
  status       SimilarityReportStatus @default(RUNNING)

  submissionSnapshot Json
  summary            Json    @default("{}")
  error              String?

  assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  matches    SimilarityMatch[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([assignmentId, createdAt])
  @@index([status])
}

model SimilarityMatch {
  id            String              @id @default(cuid())
  reportId      String
  submissionAId String
  submissionBId String
  matchType     SimilarityMatchType

  exactFile       Boolean @default(false)
  exactText       Boolean @default(false)
  lexicalScore    Float   @default(0)
  semanticScore   Float   @default(0)
  combinedScore   Float   @default(0)
  matchedPassages Json    @default("[]")
  aiExplanation   String?
  aiModel         String?
  aiUsage         Json?

  report      SimilarityReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  submissionA Submission             @relation("SimilaritySubmissionA", fields: [submissionAId], references: [id], onDelete: Cascade)
  submissionB Submission             @relation("SimilaritySubmissionB", fields: [submissionBId], references: [id], onDelete: Cascade)
  review      SimilarityMatchReview?

  createdAt DateTime @default(now())

  @@unique([reportId, submissionAId, submissionBId])
  @@index([reportId, combinedScore])
  @@index([submissionAId])
  @@index([submissionBId])
}

model SimilarityMatchReview {
  id           String                   @id @default(cuid())
  matchId      String                   @unique
  decision     SimilarityReviewDecision @default(PENDING)
  notes        String?
  reviewedById String
  reviewedAt   DateTime                 @default(now())

  match SimilarityMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([decision])
  @@index([reviewedById])
}

model SimilarityEmbedding {
  id           String                      @id @default(cuid())
  assignmentId String
  submissionId String
  model        String
  textHash     String
  textPreview  String?
  embedding    Unsupported("vector(1536)")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, submissionId, model, textHash])
  @@index([assignmentId, model])
  @@map("assignment_similarity_embeddings")
}

// ============ QUIZ MANAGEMENT ============

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuizDeliveryMode {
  ONLINE
  OFFLINE
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

model Quiz {
  id               String           @id @default(cuid())
  offeringId       String
  componentIndex   Int?
  title            String
  description      String?
  totalMarks       Float            @default(0)
  durationMinutes  Int              @default(30)
  startAt          DateTime
  endAt            DateTime
  status           QuizStatus       @default(DRAFT)
  deliveryMode     QuizDeliveryMode @default(ONLINE)
  shuffleQuestions Boolean          @default(false)
  maxViolations    Int              @default(3)
  allowReview      Boolean          @default(true)

  offering     CourseOffering    @relation(fields: [offeringId], references: [id])
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  reopenGrants QuizReopenGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offeringId, componentIndex])
  @@index([offeringId])
  @@index([status])
  @@index([startAt])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  questionText  String
  options       Json         @default("[]") // for MCQ: ["a","b","c","d"]; TF: ["True","False"]
  correctAnswer Json // MCQ: index (0-3); TF: 0|1; SHORT: string
  marks         Float        @default(1)
  order         Int          @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, order])
}

model QuizAttempt {
  id        String @id @default(cuid())
  quizId    String
  studentId String

  startedAt     DateTime          @default(now())
  submittedAt   DateTime?
  status        QuizAttemptStatus @default(IN_PROGRESS)
  reopenedUntil DateTime?
  reopenedBy    String?
  reopenedAt    DateTime?
  reopenGrantId String?

  totalScore      Float?
  autoGradedScore Float? // sum of MCQ + TRUE_FALSE auto-marks
  manualScore     Float? // sum of teacher-graded SHORT marks

  violations    Int  @default(0)
  violationLog  Json @default("[]") // [{type, at}]
  questionOrder Json @default("[]") // immutable QuizQuestion.id order for this attempt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id])
  answers QuizAnswer[]

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
}

model QuizReopenGrant {
  id        String    @id @default(cuid())
  quizId    String
  studentId String
  grantedBy String
  until     DateTime
  reason    String?
  usedAt    DateTime?

  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizId, studentId])
  @@index([quizId, until])
  @@index([studentId, until])
}

model QuizAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  answer       Json? // MCQ/TF: index; SHORT: string
  isCorrect    Boolean? // null until graded (SHORT) or auto-set (MCQ/TF)
  marksAwarded Float    @default(0)
  feedback     String?

  attempt         QuizAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        QuizQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  taPendingGrades TAPendingGrade[] @relation("PendingQuizAnswerGrade")

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ============ Q&A FORUM ============

enum QnaStatus {
  OPEN
  RESOLVED
}

model QnaThread {
  id         String    @id @default(cuid())
  offeringId String
  askedById  String // User.id of asker
  title      String
  body       String
  status     QnaStatus @default(OPEN)

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  replies  QnaReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offeringId])
  @@index([askedById])
  @@index([status])
}

model QnaReply {
  id       String @id @default(cuid())
  threadId String
  authorId String // User.id of replier
  body     String

  thread QnaThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([authorId])
}

// ============ LEAVE MANAGEMENT ============

enum LeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

model LeaveApplication {
  id         String @id @default(cuid())
  studentId  String
  offeringId String

  fromDate      DateTime @db.Date
  toDate        DateTime @db.Date
  reason        String
  attachmentUrl String?

  status      LeaveApplicationStatus @default(PENDING)
  reviewedBy  String? // teacher userId
  reviewNotes String?
  reviewedAt  DateTime?

  student  Student        @relation(fields: [studentId], references: [id])
  offering CourseOffering @relation(fields: [offeringId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([offeringId])
  @@index([status])
}

model Fine {
  id         String @id @default(cuid())
  studentId  String
  offeringId String
  quotaUnit  Int?

  reason String // e.g. "Absent on 2026-03-12 (over 4-leave quota)"
  amount Float
  status FineStatus @default(UNPAID)

  student  Student        @relation(fields: [studentId], references: [id])
  offering CourseOffering @relation(fields: [offeringId], references: [id])

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@unique([studentId, offeringId, quotaUnit])
  @@index([studentId])
  @@index([offeringId])
  @@index([status])
}

// ============ TA ASSIGNMENTS ============

enum TAStatus {
  PENDING
  APPROVED
  REJECTED
  RELIEVED
}

enum TAPermission {
  MARK_ATTENDANCE
  GRADE_ASSIGNMENTS
  GRADE_QUIZZES
  ANSWER_QNA
  UPLOAD_RESOURCES
  VIEW_ROSTER
}

model TAAssignment {
  id         String @id @default(cuid())
  studentId  String
  offeringId String

  status      TAStatus       @default(PENDING)
  permissions TAPermission[] @default([VIEW_ROSTER])

  appliedSemester   Int
  targetSemesterMin Int
  targetSemesterMax Int

  reason      String?
  reviewNotes String?   @db.VarChar(1000)
  reviewedBy  String?
  reviewedAt  DateTime?

  appliedAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  student   Student        @relation(fields: [studentId], references: [id])
  offering  CourseOffering @relation(fields: [offeringId], references: [id])
  resources TAResource[]

  @@unique([studentId, offeringId])
  @@index([offeringId, status])
  @@index([studentId, status])
}

model TAResource {
  id                  String @id @default(cuid())
  offeringId          String
  taAssignmentId      String
  uploadedByStudentId String

  title       String
  description String?
  fileUrl     String
  fileName    String
  filePath    String?
  mimeType    String?

  offering     CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  taAssignment TAAssignment   @relation(fields: [taAssignmentId], references: [id], onDelete: Cascade)
  uploadedBy   Student        @relation(fields: [uploadedByStudentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offeringId, createdAt])
  @@index([taAssignmentId])
  @@index([uploadedByStudentId])
}

// ============ NOTIFICATIONS ============

model Notification {
  id       String    @id @default(cuid())
  userId   String // recipient
  type     String // ANNOUNCEMENT, ASSIGNMENT_NEW, ASSIGNMENT_GRADED, QUIZ_NEW, QNA_REPLY, QNA_NEW, ATTENDANCE_LOW, GENERAL
  title    String
  body     String?
  linkUrl  String? // optional in-app target
  metadata Json      @default("{}")
  isRead   Boolean   @default(false)
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ============ SCHEDULING ============

enum SessionType {
  LECTURE
  LAB
  PROJECT
}

enum RoomType {
  LECTURE
  LAB
  SEMINAR
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model ScheduleConfig {
  id                       String   @id @default("default")
  lectureDurationMin       Int      @default(90)
  breakDurationMin         Int      @default(15)
  dayStartTime             String   @default("09:00")
  workingDays              Json     @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\",\"SAT\"]")
  regularLecturesPerDay    Int      @default(4)
  maxTeacherLecturesPerDay Int      @default(3)
  defaultSessionsPerCourse Int      @default(2)
  dayOverrides             Json     @default("{\"FRI\":{\"lecturesPerDay\":3,\"jummahAfterSlot\":2,\"jummahMin\":60}}")
  updatedAt                DateTime @updatedAt
}

model Room {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String?
  type     RoomType
  capacity Int      @default(40)
  building String?
  floor    Int?
  isActive Boolean  @default(true)

  sessions ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([building, floor])
}

model ClassSession {
  id         String    @id @default(cuid())
  offeringId String
  dayOfWeek  DayOfWeek
  slotIndex  Int
  roomId     String

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  room     Room           @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())

  @@unique([offeringId, dayOfWeek, slotIndex])
  @@index([roomId, dayOfWeek, slotIndex])
  @@index([offeringId])
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  name        String
  isRecurring Boolean  @default(false)
  termId      String?

  createdAt DateTime @default(now())

  @@unique([date, name])
  @@index([termId])
}

// ============ COURSE GRADE STRUCTURE ============

enum ComponentKind {
  ASSIGNMENT
  QUIZ
  MID
  FINAL
  PROJECT_PRESENTATION
  PARTICIPATION
  LAB_WORK
}

// Per-course grade configuration. Defines what mark components exist in this course.
model CourseGradeComponent {
  id               String        @id @default(cuid())
  courseId         String
  kind             ComponentKind
  label            String // display name e.g. "Assignment", "Lab Work"
  count            Int // e.g. 4 assignments
  totalPerInstance Float // total marks per single instance
  weightPercent    Float // % of final grade
  aggregation      String        @default("AVERAGE") // AVERAGE | SINGLE
  orderIndex       Int           @default(0) // display order
  marksReleased    Boolean       @default(true) // when false, students can't see obtainedMarks for this component

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, kind])
  @@index([courseId])
}

// Per-student per-component score entry.
model MarkComponent {
  id            String        @id @default(cuid())
  enrollmentId  String
  kind          ComponentKind
  index         Int           @default(1) // 1..count
  title         String? // teacher-set ("HW2: Recursion")
  date          DateTime?     @db.Date
  totalMarks    Float
  obtainedMarks Float? // null until graded
  fileUrl       String? // teacher attachment (Supabase)
  fileName      String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, kind, index])
  @@index([enrollmentId])
  @@index([kind])
}

// ============ LECTURES ============

model Lecture {
  id           String   @id @default(cuid())
  offeringId   String
  date         DateTime @db.Date
  title        String
  description  String?
  materialUrl  String? // Supabase Storage URL
  materialName String? // original filename
  createdBy    String // teacher userId

  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offeringId, date])
}
